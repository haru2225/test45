set -euo pipefail
cd "${PBS_O_WORKDIR:-$(dirname "${BASH_SOURCE[0]}")}"
# Activate the environment created in README step 1 (edit to match your site).
source "${VENV:-$HOME/venvs/test45}/bin/activate"
exec python -u test45.py
